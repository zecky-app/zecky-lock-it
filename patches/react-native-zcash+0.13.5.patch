+  /// Zecky addition: how many incoming payments each of the wallet's own
+  /// addresses has received, as { address: count }.
+  @objc func addressUsage(
+    _ alias: String, resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    Task {
+      if let wallet = await synchronizerStore.get(alias) {
+        do {
+          let txs = try await wallet.synchronizer.allTransactions()
+          var counts: [String: Int] = [:]
+          for tx in txs where !tx.isSentTransaction {
+            let outputs = await wallet.synchronizer.getTransactionOutputs(for: tx)
+            var paidTo = Set<String>()
+            for output in outputs where !output.isChange {
+              if case .address(let recipient) = output.recipient {
+                paidTo.insert(recipient.stringEncoded)
+              }
+            }
+            for address in paidTo {
+              counts[address, default: 0] += 1
+            }
+          }
+          resolve(counts as NSDictionary)
+        } catch {
+          reject("addressUsage", "Failed to read address usage", error)
+        }
+      } else {
+        reject("addressUsage", "Wallet does not exist", genericError)
+      }
+    }
+  }
