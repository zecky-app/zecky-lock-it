+  /// Zecky addition: a fresh shielded-only unified address on every call.
+  /// All of them belong to the same account, so funds sent to any of them
+  /// show up in the same balance.
+  @objc func deriveRotatingAddress(
+    _ alias: String, resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    Task {
+      if let wallet = await synchronizerStore.get(alias) {
+        do {
+          guard let accountUUID = wallet.accountUUID else {
+            reject("deriveRotatingAddress", "Account UUID not found", genericError)
+            return
+          }
+          let receivers: Set<ReceiverType> = [.sapling, .orchard]
+          let address = try await wallet.synchronizer.getCustomUnifiedAddress(
+            accountUUID: accountUUID, receivers: receivers)
+          resolve(address.stringEncoded)
+        } catch {
+          reject("deriveRotatingAddress", "Failed to derive a new address", error)
+        }
+      } else {
+        reject("deriveRotatingAddress", "Wallet does not exist", genericError)
+      }
+    }
+  }
