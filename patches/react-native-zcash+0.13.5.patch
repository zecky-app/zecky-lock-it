+/// Zecky addition: every file and folder the wallet keeps in Documents.
+///
+/// The SDK stores a wallet with a custom alias under prefixed names
+/// ("c_<alias>_data.db", see URL+UpdateWithAlias.swift), so the SDK's own
+/// renaming rule is applied here. The plain names are listed as well, which
+/// costs nothing and covers files from before the SDK used aliases.
+func walletFileURLs(_ alias: String, _ network: ZcashNetwork) -> [URL] {
+  var plain: [URL] = []
+  if let dataDb = try? dataDbURLHelper(alias, network) { plain.append(dataDb) }
+  if let cacheDb = try? cacheDbURLHelper(alias, network) { plain.append(cacheDb) }
+  if let blocks = try? fsBlockDbRootURLHelper(alias, network) { plain.append(blocks) }
+  if let general = try? generalStorageURLHelper(alias, network) { plain.append(general) }
+  if let tor = try? torDirURLHelper(alias, network) { plain.append(tor) }
+
+  let sdkAlias = ZcashSynchronizerAlias.custom(alias)
+  var urls: [URL] = []
+  for url in plain {
+    for candidate in [url.updateLastPathComponent(with: sdkAlias), url] {
+      guard let candidate else { continue }
+      urls.append(candidate)
+      if candidate.pathExtension == "db" {
+        // SQLite keeps recent changes in these side files.
+        urls.append(URL(fileURLWithPath: candidate.path + "-wal"))
+        urls.append(URL(fileURLWithPath: candidate.path + "-shm"))
+      }
+    }
+  }
+  return urls
+}
