+
+func excludeFromBackup(_ urls: [URL]) {
+  for url in urls where FileManager.default.fileExists(atPath: url.path) {
+    var target = url
+    var values = URLResourceValues()
+    values.isExcludedFromBackup = true
+    try? target.setResourceValues(values)
+  }
+}
