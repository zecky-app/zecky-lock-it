+/// protection class, so files that are not open cannot be read while the
+/// iPhone is locked; the open database keeps working until Zecky closes it.
+/// Zecky (audit C-24): the two Sapling parameter files in the app bundle,
+/// when this build includes them.
+func bundledSaplingParams() -> (spend: URL, output: URL)? {
+  guard
+    let spend = Bundle.main.url(forResource: "sapling-spend", withExtension: "params"),
+    let output = Bundle.main.url(forResource: "sapling-output", withExtension: "params")
