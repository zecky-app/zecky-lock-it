+// MARK: - Zecky addition: security keys (FIDO2)
+//
+// Pairing and checking go through Apple's own security key sheet, for the
+// relying party zecky.app (linked by the app's Associated Domains and the
+// site's apple-app-site-association). The tap happens over NFC, USB-C or
+// Lightning; nothing goes over the network. The JavaScript side checks the
+// answer's contents; the signature is checked here with CryptoKit.
+
+@available(iOS 15.0, *)
+final class SecurityKeyRequest: NSObject, ASAuthorizationControllerDelegate,
+  ASAuthorizationControllerPresentationContextProviding
+{
+  static let relyingParty = "zecky.app"
+  /// One request at a time, kept alive until Apple's sheet answers.
+  private static var current: SecurityKeyRequest?
+
+  private let resolve: RCTPromiseResolveBlock
+  private let reject: RCTPromiseRejectBlock
+  private var controller: ASAuthorizationController?
+
+  private init(
+    resolve: @escaping RCTPromiseResolveBlock, reject: @escaping RCTPromiseRejectBlock
+  ) {
+    self.resolve = resolve
+    self.reject = reject
+  }
+
+  /// Must be called on the main thread.
+  static func start(
+    _ request: ASAuthorizationRequest,
+    resolve: @escaping RCTPromiseResolveBlock, reject: @escaping RCTPromiseRejectBlock
+  ) {
+    if current != nil {
+      reject("SECURITY_KEY_BUSY", "A security key request is already open", nil)
+      return
+    }
+    let handler = SecurityKeyRequest(resolve: resolve, reject: reject)
+    let controller = ASAuthorizationController(authorizationRequests: [request])
+    controller.delegate = handler
+    controller.presentationContextProvider = handler
+    handler.controller = controller
+    current = handler
+    controller.performRequests()
+  }
+
+  private func finish() {
+    controller = nil
+    SecurityKeyRequest.current = nil
+  }
+
+  func presentationAnchor(for controller: ASAuthorizationController) -> ASPresentationAnchor {
+    let windows = UIApplication.shared.connectedScenes
+      .compactMap { $0 as? UIWindowScene }
+      .flatMap { $0.windows }
+    return windows.first { $0.isKeyWindow } ?? windows.first ?? ASPresentationAnchor()
+  }
+
+  func authorizationController(
+    controller: ASAuthorizationController,
+    didCompleteWithAuthorization authorization: ASAuthorization
+  ) {
+    defer { finish() }
+    if let created = authorization.credential
+      as? ASAuthorizationSecurityKeyPublicKeyCredentialRegistration
+    {
+      resolve([
+        "credentialId": created.credentialID.base64EncodedString(),
+        "attestationObject": (created.rawAttestationObject as Data?)?.base64EncodedString() ?? "",
+        "clientDataJSON": created.rawClientDataJSON.base64EncodedString(),
+      ])
+    } else if let answer = authorization.credential
+      as? ASAuthorizationSecurityKeyPublicKeyCredentialAssertion
+    {
+      resolve([
+        "credentialId": answer.credentialID.base64EncodedString(),
+        "authenticatorData": (answer.rawAuthenticatorData as Data?)?.base64EncodedString() ?? "",
+        "clientDataJSON": answer.rawClientDataJSON.base64EncodedString(),
+        "signature": (answer.signature as Data?)?.base64EncodedString() ?? "",
+      ])
+    } else {
+      reject("SECURITY_KEY_FAILED", "Unexpected answer from the security key", nil)
+    }
+  }
+
+  func authorizationController(
+    controller: ASAuthorizationController, didCompleteWithError error: Error
+  ) {
+    defer { finish() }
+    let cancelled = (error as? ASAuthorizationError)?.code == .canceled
+    reject(
+      cancelled ? "SECURITY_KEY_CANCELLED" : "SECURITY_KEY_FAILED",
+      error.localizedDescription, error)
+  }
+}
+
+extension RNZcash {
+  /// Zecky addition: whether this iPhone can use security keys.
+  @objc func securityKeySupported(
+    _ resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    if #available(iOS 15.0, *) {
+      resolve(true)
+    } else {
+      resolve(false)
+    }
+  }
+
+  /// Zecky addition: pairs a security key. challenge and userId are base64.
+  /// The credential is not stored on the key itself (no resident key), so
+  /// the key's own list of logins does not show Zecky.
+  @objc func securityKeyRegister(
+    _ challenge: String, _ userId: String,
+    resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    guard #available(iOS 15.0, *) else {
+      reject("SECURITY_KEY_UNSUPPORTED", "Needs iOS 15 or later", nil)
+      return
+    }
+    guard let challengeData = Data(base64Encoded: challenge),
+      let userData = Data(base64Encoded: userId)
+    else {
+      reject("SECURITY_KEY_FAILED", "Invalid input", nil)
+      return
+    }
+    DispatchQueue.main.async {
+      let provider = ASAuthorizationSecurityKeyPublicKeyCredentialProvider(
+        relyingPartyIdentifier: SecurityKeyRequest.relyingParty)
+      let request = provider.createCredentialRegistrationRequest(
+        challenge: challengeData, displayName: "Zecky Lock it", name: "Zecky Lock it",
+        userID: userData)
+      request.credentialParameters = [
+        ASAuthorizationPublicKeyCredentialParameters(algorithm: .ES256)
+      ]
+      request.residentKeyPreference = .discouraged
+      request.userVerificationPreference = .discouraged
+      request.attestationPreference = .none
+      SecurityKeyRequest.start(request, resolve: resolve, reject: reject)
+    }
+  }
+
+  /// Zecky addition: asks for one of the paired keys (credential IDs in
+  /// base64) to answer a fresh challenge.
+  @objc func securityKeyAssert(
+    _ challenge: String, _ credentialIds: [String],
+    resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    guard #available(iOS 15.0, *) else {
+      reject("SECURITY_KEY_UNSUPPORTED", "Needs iOS 15 or later", nil)
+      return
+    }
+    let ids = credentialIds.compactMap { Data(base64Encoded: $0) }
+    guard let challengeData = Data(base64Encoded: challenge), !ids.isEmpty,
+      ids.count == credentialIds.count
+    else {
+      reject("SECURITY_KEY_FAILED", "Invalid input", nil)
+      return
+    }
+    DispatchQueue.main.async {
+      let provider = ASAuthorizationSecurityKeyPublicKeyCredentialProvider(
+        relyingPartyIdentifier: SecurityKeyRequest.relyingParty)
+      let request = provider.createCredentialAssertionRequest(challenge: challengeData)
+      request.allowedCredentials = ids.map {
+        ASAuthorizationSecurityKeyPublicKeyCredentialDescriptor(
+          credentialID: $0,
+          transports: ASAuthorizationSecurityKeyPublicKeyCredentialDescriptor.Transport
+            .allSupported)
+      }
+      request.userVerificationPreference = .discouraged
+      SecurityKeyRequest.start(request, resolve: resolve, reject: reject)
+    }
+  }
+
+  /// Zecky addition: checks a security key's ES256 signature over
+  /// authenticatorData + SHA-256(clientDataJSON). All inputs base64; the
+  /// public key is the uncompressed 65-byte form. Resolves true or false.
+  @objc func securityKeyVerify(
+    _ publicKey: String, _ authenticatorData: String, _ clientDataJSON: String,
+    _ signature: String,
+    resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    guard let keyData = Data(base64Encoded: publicKey),
+      let authData = Data(base64Encoded: authenticatorData),
+      let clientData = Data(base64Encoded: clientDataJSON),
+      let signatureData = Data(base64Encoded: signature)
+    else {
+      resolve(false)
+      return
+    }
+    do {
+      let key = try P256.Signing.PublicKey(x963Representation: keyData)
+      let ecdsa = try P256.Signing.ECDSASignature(derRepresentation: signatureData)
+      var message = authData
+      message.append(contentsOf: SHA256.hash(data: clientData))
+      resolve(key.isValidSignature(ecdsa, for: message))
+    } catch {
+      resolve(false)
+    }
+  }
+}
