+  /// Zecky addition: route the privacy-sensitive calls (sending, looking
+  /// up the wallet's own transactions, chain-height checks) through Tor.
+  /// If Tor cannot start this rejects and the wallet stays on a direct
+  /// connection.
+  @objc func setTor(
+    _ alias: String, _ enabled: Bool,
+    resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    Task {
+      if let wallet = await synchronizerStore.get(alias) {
+        do {
+          try await wallet.synchronizer.tor(enabled: enabled)
+          resolve(nil)
+        } catch {
+          reject("setTor", "Failed to change the Tor setting", error)
+        }
+      } else {
+        reject("setTor", "Wallet does not exist", genericError)
+      }
+    }
+  }
