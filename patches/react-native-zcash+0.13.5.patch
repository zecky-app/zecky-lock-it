+// MARK: - Zecky addition: security keys (FIDO2)
+//
+// Pairing and checking go through Apple's own security key sheet, for the
+// relying party zecky.app (linked by the app's Associated Domains and the
+// site's apple-app-site-association). The tap happens over NFC, USB-C or
+// Lightning; nothing goes over the network. The JavaScript side checks the
+// answer's contents; the signature is checked here with CryptoKit.
+
+@available(iOS 15.0, *)
+final class SecurityKeyRequest: NSObject, ASAuthorizationControllerDelegate,
+  ASAuthorizationControllerPresentationContextProviding
+{
+  static let relyingParty = "zecky.app"
+  /// One request at a time, kept alive until Apple's sheet answers.
+  private static var current: SecurityKeyRequest?
+
+  private let resolve: RCTPromiseResolveBlock
+  private let reject: RCTPromiseRejectBlock
+  private var controller: ASAuthorizationController?
+
+  private init(
+    resolve: @escaping RCTPromiseResolveBlock, reject: @escaping RCTPromiseRejectBlock
+  ) {
+    self.resolve = resolve
+    self.reject = reject
+  }
+
+  /// Must be called on the main thread.
+  static func start(
+    _ request: ASAuthorizationRequest,
+    resolve: @escaping RCTPromiseResolveBlock, reject: @escaping RCTPromiseRejectBlock
+  ) {
+    if current != nil {
+      reject("SECURITY_KEY_BUSY", "A security key request is already open", nil)
+      return
+    }
+    let handler = SecurityKeyRequest(resolve: resolve, reject: reject)
+    let controller = ASAuthorizationController(authorizationRequests: [request])
+    controller.delegate = handler
+    controller.presentationContextProvider = handler
+    handler.controller = controller
+    current = handler
+    controller.performRequests()
+  }
+
+  private func finish() {
+    controller = nil
+    SecurityKeyRequest.current = nil
+  }
+
+  func presentationAnchor(for controller: ASAuthorizationController) -> ASPresentationAnchor {
+    let windows = UIApplication.shared.connectedScenes
+      .compactMap { $0 as? UIWindowScene }
+      .flatMap { $0.windows }
+    return windows.first { $0.isKeyWindow } ?? windows.first ?? ASPresentationAnchor()
+  }
+
+  func authorizationController(
+    controller: ASAuthorizationController,
+    didCompleteWithAuthorization authorization: ASAuthorization
+  ) {
+    defer { finish() }
+    if let created = authorization.credential
+      as? ASAuthorizationSecurityKeyPublicKeyCredentialRegistration
+    {
+      resolve([
+        "credentialId": created.credentialID.base64EncodedString(),
+        "attestationObject": (created.rawAttestationObject as Data?)?.base64EncodedString() ?? "",
+        "clientDataJSON": created.rawClientDataJSON.base64EncodedString(),
+      ])
+    } else if let answer = authorization.credential
+      as? ASAuthorizationSecurityKeyPublicKeyCredentialAssertion
+    {
+      resolve([
+        "credentialId": answer.credentialID.base64EncodedString(),
+        "authenticatorData": (answer.rawAuthenticatorData as Data?)?.base64EncodedString() ?? "",
+        "clientDataJSON": answer.rawClientDataJSON.base64EncodedString(),
+        "signature": (answer.signature as Data?)?.base64EncodedString() ?? "",
+      ])
+    } else {
+      reject("SECURITY_KEY_FAILED", "Unexpected answer from the security key", nil)
+    }
+  }
+
+  func authorizationController(
+    controller: ASAuthorizationController, didCompleteWithError error: Error
+  ) {
+    defer { finish() }
+    let cancelled = (error as? ASAuthorizationError)?.code == .canceled
+    reject(
+      cancelled ? "SECURITY_KEY_CANCELLED" : "SECURITY_KEY_FAILED",
+      error.localizedDescription, error)
+  }
+}
