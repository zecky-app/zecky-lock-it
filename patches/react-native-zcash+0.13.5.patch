+  /// Zecky addition: stops the wallet and deletes everything it stored on
+  /// this device (database, block cache, Tor state). The recovery phrase is
+  /// kept elsewhere and is removed by the app itself.
+  @objc func wipeWallet(
+    _ alias: String, _ networkName: String,
+    resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    Task {
+      let network = getNetworkParams(networkName)
+      if let wallet = await synchronizerStore.get(alias) {
+        // The SDK's own wipe stops syncing, closes every database
+        // connection and removes the data. Deleting files under a wallet
+        // that is still open leaves the old data in use.
+        do {
+          for try await _ in wallet.synchronizer.wipe().values {}
+        } catch {
+          wallet.synchronizer.stop()
+          try? await Task.sleep(nanoseconds: 1_000_000_000)
+        }
