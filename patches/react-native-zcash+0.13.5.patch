+  /// Zecky addition: the ZEC price in USD, fetched by the SDK over Tor so
+  /// the price source never sees the phone's internet address.
+  @objc func usdRate(
+    _ alias: String, resolver resolve: @escaping RCTPromiseResolveBlock,
+    rejecter reject: @escaping RCTPromiseRejectBlock
+  ) {
+    Task {
+      if let wallet = await synchronizerStore.get(alias) {
+        do {
+          let synchronizer = wallet.synchronizer
+          try await synchronizer.exchangeRateOverTor(enabled: true)
+          synchronizer.refreshExchangeRateUSD()
+
+          let rate: Double? = await withTaskGroup(of: Double?.self) { group in
+            group.addTask {
+              var emptyResults = 0
+              for await result in synchronizer.exchangeRateUSDStream.values {
+                guard let result = result else {
+                  // The first empty value is the stream's starting state;
+                  // a second one means the fetch failed with nothing cached.
+                  emptyResults += 1
+                  if emptyResults >= 2 { return nil }
+                  continue
+                }
+                if result.state == .error { return nil }
+                if result.state == .success && result.date.timeIntervalSinceNow > -600 {
+                  return result.rate.doubleValue
+                }
+              }
+              return nil
+            }
+            group.addTask {
+              try? await Task.sleep(nanoseconds: 60_000_000_000)
+              return nil
+            }
+            let first: Double? = await group.next() ?? nil
+            group.cancelAll()
+            return first
+          }
+
+          if let rate = rate {
+            resolve(rate)
+          } else {
+            reject("usdRate", "Could not fetch the exchange rate", genericError)
+          }
+        } catch {
+          reject("usdRate", "Could not fetch the exchange rate", error)
+        }
+      } else {
+        reject("usdRate", "Wallet does not exist", genericError)
+      }
+    }
+  }
